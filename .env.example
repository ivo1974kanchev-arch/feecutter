# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co        # Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                      # Supabase anon key (public, safe for browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key                  # Service role key — NEVER expose to client
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres  # Direct DB connection for migrations

# ─── Stripe ──────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxx                  # Stripe publishable key (public)
STRIPE_SECRET_KEY=sk_live_xxxx                                   # Stripe secret key — server-only
STRIPE_WEBHOOK_SECRET=whsec_xxxx                                 # Webhook signing secret from Stripe dashboard
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxx                           # Stripe Price ID for Pro plan ($9/mo)
STRIPE_PRO_ANNUAL_PRICE_ID=price_xxxx                            # Stripe Price ID for Pro Annual plan ($79/yr)

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_xxxx                                           # Resend API key for transactional + nurture email
RESEND_FROM_EMAIL=hello@feecutter.com                            # Verified sender address in Resend

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://feecutter.com                        # Full public URL — used for shareable report links
NEXTAUTH_SECRET=your-random-secret-min-32-chars                  # Random secret for session signing (openssl rand -base64 32)